rules_version = '2';

// Anonymous feedback + visit tracking.
//
// The web config in the client bundle is public by design, so THIS FILE is the
// only thing standing between the internet and the database.
//
// 'feedback' is create-only and permanently unreadable from any client: read
// submissions in the Firebase console or with the Admin SDK, which bypass
// these rules. 'visits' is append-only for everyone and readable only by the
// signed-in admin account, which is what powers the /admin page.
//
// Deploy with:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function isText(value, max) {
      return value is string && value.size() <= max;
    }

    match /feedback/{docId} {
      allow read, update, delete: if false;

      allow create: if
        request.resource.data.keys().hasOnly([
          'projectSlug', 'rating', 'role', 'wouldUse', 'highlights',
          'missing', 'extra', 'contact', 'ref', 'createdAt'
        ])
        && isText(request.resource.data.projectSlug, 64)
        && request.resource.data.projectSlug.size() > 0
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && isText(request.resource.data.role, 40)
        && isText(request.resource.data.wouldUse, 20)
        && request.resource.data.highlights is list
        && request.resource.data.highlights.size() <= 8
        && isText(request.resource.data.missing, 2000)
        && isText(request.resource.data.extra, 2000)
        && isText(request.resource.data.contact, 200)
        && isText(request.resource.data.ref, 60)
        // Forces serverTimestamp(): a client cannot backdate or forge this.
        && request.resource.data.createdAt == request.time;
    }

    // Visit tracking. Replaces the old create-only 'pageviews' collection,
    // which only knew a project slug and could never be read back.
    //
    // Anyone may append a visit; only the admin account may read them. Email /
    // password sign-in is the gate, and public self-signup is disabled in the
    // Firebase console, so nobody can mint an account to match this address.
    // (email_verified is deliberately NOT required: accounts created from the
    // console start unverified, which would lock the admin out.)
    match /visits/{docId} {
      allow read: if request.auth != null
        && request.auth.token.email == 'chandrapavanreddy@gmail.com';

      allow update, delete: if false;

      allow create: if
        request.resource.data.keys().hasOnly([
          'path', 'ref', 'referrer', 'ua', 'createdAt'
        ])
        && isText(request.resource.data.path, 200)
        && request.resource.data.path.size() > 0
        && isText(request.resource.data.ref, 60)
        && isText(request.resource.data.referrer, 300)
        && isText(request.resource.data.ua, 300)
        // Forces a REQUEST_TIME transform: a client cannot backdate this.
        && request.resource.data.createdAt == request.time;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

VITE_CHATBOT_API_URL=https://profile-bot-api-977721269659.us-west2.run.app/ask

# Firebase web config for the anonymous feedback pages.
# Optional: values pasted into src/lib/firebaseConfig.js take precedence, and
# committing them there is the recommended route since they are public anyway
# (access is controlled by firestore.rules). Use these only to point a local
# dev build at a different Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# The Firestore instance is a named database, not "(default)". Defaults to
# "pfeedback" in src/lib/firebaseConfig.js; override only to target another one.
VITE_FIREBASE_DATABASE_ID=
